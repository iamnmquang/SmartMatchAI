# SmartMatch AI — environment variables
# Copy to .env and fill in real values. NEVER commit .env.
# Each group notes the phase that starts reading it.

# ---- App ----
# development | production
APP_ENV=development
LOG_LEVEL=INFO

# ---- PostgreSQL (Phase 8) ----
POSTGRES_USER=smartmatch
POSTGRES_PASSWORD=change-me
POSTGRES_DB=smartmatch
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ---- LLM (Phase 10) ----
# mock | openai  — mock needs no API key (dev, tests, CI)
LLM_PROVIDER=mock
# Model name from the provider's current model list
LLM_MODEL=
# Required only when LLM_PROVIDER=openai
OPENAI_API_KEY=

# ---- Embeddings (Phase 11) ----
# mock | openai
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=
